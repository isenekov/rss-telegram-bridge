{
  "$schema": "https://developers.reddit.com/schema/config-file.v1.json",
  "name": "gfar34",
  "server": { "dir": "dist/server", "entry": "index.cjs" },
  "permissions": {
    "reddit": { "enable": true, "scope": "user" },
    "redis": true,
    "http": { "enable": true, "domains": ["api.telegram.org"] }
  },
  "scheduler": {
    "tasks": {
      "read-new-posts": {
        "endpoint": "/internal/scheduler/read",
        "cron": "*/5 * * * *"
      },
      "maintain-telegram": {
        "endpoint": "/internal/scheduler/telegram",
        "cron": "2-59/5 * * * *"
      }
    }
  },
  "settings": {
    "global": {
      "installationSubreddit": {
        "type": "string",
        "label": "Your own test subreddit (without r/)",
        "defaultValue": ""
      },
      "TELEGRAM_BOT_TOKEN": {
        "type": "string",
        "isSecret": true,
        "label": "Telegram bot token"
      },
      "TELEGRAM_CHAT_ID": {
        "type": "string",
        "isSecret": true,
        "label": "Numeric Telegram chat ID"
      }
    },
    "subreddit": {
      "pollingEnabled": {
        "type": "boolean",
        "label": "Collect public post IDs every 5 minutes",
        "defaultValue": false
      },
      "telegramDeliveryEnabled": {
        "type": "boolean",
        "label": "Send new posts to Telegram",
        "helpText": "Enable after Reddit approves this version. The first run starts a fresh delivery window. Existing messages can still be updated when new sends are paused.",
        "defaultValue": false
      }
    }
  },
  "menu": {
    "items": [
      {
        "label": "GLR: read source now (no sending)",
        "forUserType": "moderator",
        "location": "subreddit",
        "endpoint": "/internal/menu/read"
      },
      {
        "label": "GLR: collector status",
        "forUserType": "moderator",
        "location": "subreddit",
        "endpoint": "/internal/menu/status"
      },
      {
        "label": "GLR: verify Telegram connection",
        "forUserType": "moderator",
        "location": "subreddit",
        "endpoint": "/internal/menu/verify-telegram"
      },
      {
        "label": "GLR: queue 5 latest posts for Telegram (once)",
        "forUserType": "moderator",
        "location": "subreddit",
        "endpoint": "/internal/menu/queue-latest-five"
      }
    ]
  }
}
